# ==========================================
# KONFIGURASI KEAMANAN & LINGKUNGAN (ENVIRONMENT)
# ==========================================
# Salin file ini menjadi .env untuk penggunaan production
# JANGAN membagikan file .env Anda ke publik atau repository git!

# --- KONFIGURASI DATABASE ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=undangan_digital

# --- MODE APLIKASI ---
# Set 'false' untuk Production/Konsumen, 'true' hanya untuk lokal development
IS_DEV_MODE=false

# --- KONFIGURASI SMTP (PHPMailer / OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=email_kamu@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=noreply@nikahyuk.com

# --- KONFIGURASI MIDTRANS (Payment Gateway) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
# Set 'true' untuk Production, 'false' untuk Sandbox/Testing
MIDTRANS_IS_PRODUCTION=false

# --- AKUN ADMIN AWAL (db_setup.php) ---
ADMIN_EMAIL=admin@nikahkita.com
ADMIN_PASSWORD=admin123

